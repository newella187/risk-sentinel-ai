{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "cleanUrls": true,
  "framework": null,
  "installCommand": "",
  "outputDirectory": ".",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
